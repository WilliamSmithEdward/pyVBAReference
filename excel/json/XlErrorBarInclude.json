{
  "name": "XlErrorBarInclude",
  "kind": "Enumeration",
  "library": "Microsoft Excel 16.0 Object Library",
  "description": "Specifies which error-bar parts to include.",
  "constants": [
    {
      "name": "xlErrorBarIncludeBoth",
      "value": 1,
      "description": "Both positive and negative error range."
    },
    {
      "name": "xlErrorBarIncludeMinusValues",
      "value": 3,
      "description": "Only negative error range."
    },
    {
      "name": "xlErrorBarIncludeNone",
      "value": -4142,
      "description": "No error bar range."
    },
    {
      "name": "xlErrorBarIncludePlusValues",
      "value": 2,
      "description": "Only positive error range."
    }
  ]
}
