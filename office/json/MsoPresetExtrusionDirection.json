{
  "name": "MsoPresetExtrusionDirection",
  "kind": "Enumeration",
  "library": "Microsoft Office 16.0 Object Library",
  "description": "Specifies the direction that the extrusion's sweep path takes away from the extruded shape (the front face of the extrusion). Used with the PresetExtrusionDirection property of the ThreeDFormat object.",
  "constants": [
    {
      "name": "msoPresetExtrusionDirectionMixed",
      "value": -2,
      "description": "Return value only; indicates a combination of the other states."
    },
    {
