      "value": 1,
      "description": "Lower right"
    },
    {
      "name": "msoExtrusionBottom",
      "value": 2,
      "description": "Lower part"
    },
    {
      "name": "msoExtrusionBottomLeft",
      "value": 3,
      "description": "Lower left"
    },
    {
      "name": "msoExtrusionRight",
      "value": 4,
      "description": "Right"
    },
    {
      "name": "msoExtrusionNone",
      "value": 5,
      "description": "No extrusion"
    },
    {
      "name": "msoExtrusionLeft",
      "value": 6,
      "description": "Left"
    },
    {
      "name": "msoExtrusionTopRight",
      "value": 7,
      "description": "Upper right"
    },
    {
      "name": "msoExtrusionTop",
      "value": 8,
      "description": "Upper part"
    },
    {
      "name": "msoExtrusionTopLeft",
      "value": 9,
      "description": "Upper left"
    }
  ]
}
