# Tools the CI workflows install, compiled to requirements-ci.txt with exact
# versions and hashes so `pip install --require-hashes` refuses anything else.
#
# Regenerate (Dependabot also keeps it current, with a 7-day cooldown):
#   uv pip compile .github/requirements/requirements-ci.in \
#       --output-file .github/requirements/requirements-ci.txt \
#       --generate-hashes --python-version 3.12 \
#       --python-platform x86_64-unknown-linux-gnu \
#       --exclude-newer <date seven days ago>

# Building the sdist and wheel without build isolation, so the backend is
# pinned here instead of floating in an isolated environment.
build
hatchling

# Checking the distribution metadata before upload.
twine

# The test suite.
pytest
