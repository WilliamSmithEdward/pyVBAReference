{
  "name": "WdTrailingCharacter",
  "kind": "Enumeration",
  "library": "Microsoft Word 16.0 Object Library",
  "description": "Specifies the character inserted after the number for a numbered list item.",
  "constants": [
    {
      "name": "wdTrailingTab",
      "value": 0,
      "description": "A tab is inserted."
    },
    {
      "name": "wdTrailingSpace",
      "value": 1,
      "description": "A space is inserted. Default."
    },
    {
      "name": "wdTrailingNone",
      "value": 2,
      "description": "No character is inserted."
    }
  ]
}
