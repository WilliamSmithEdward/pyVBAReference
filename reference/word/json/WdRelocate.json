{
  "name": "WdRelocate",
  "kind": "Enumeration",
  "library": "Microsoft Word 16.0 Object Library",
  "description": "Specifies where a paragraph should be relocated in relation to its current position.",
  "constants": [
    {
      "name": "wdRelocateUp",
      "value": 0,
      "description": "Above the previous visible paragraph."
    },
    {
      "name": "wdRelocateDown",
      "value": 1,
      "description": "Below the next visible paragraph."
    }
  ]
}
