      "value": 1,
      "description": "Excel 2002"
    },
    {
      "name": "xlPivotTableVersion11",
      "value": 2,
      "description": "Excel 2003"
    },
    {
      "name": "xlPivotTableVersion12",
      "value": 3,
      "description": "Excel 2007"
    },
    {
      "name": "xlPivotTableVersion14",
      "value": 4,
      "description": "Excel 2010"
    },
    {
      "name": "xlPivotTableVersion15",
      "value": 5,
      "description": "Excel 2013"
    },
    {
      "name": "xlPivotTableVersionCurrent",
