{
  "name": "AcMissingDataPolicy",
  "kind": "Enumeration",
  "library": "Microsoft Access 16.0 Object Library",
  "description": "Specifies the plotting strategy of a series when its chart type is acChartLine and values are missing.",
  "constants": [
    {
      "name": "acPlotAsZero",
      "value": 0,
      "description": "Plot as zero."
    },
    {
      "name": "acDoNotPlot",
      "value": 1,
      "description": "Do not plot."
    },
    {
      "name": "acPlotAsInterpolated",
      "value": 2,
      "description": "Plot as interpolated."
    }
  ]
}
