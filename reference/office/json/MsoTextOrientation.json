{
  "name": "MsoTextOrientation",
  "kind": "Enumeration",
  "library": "Microsoft Office 16.0 Object Library",
  "description": "Specifies orientation for text.",
  "constants": [
    {
      "name": "msoTextOrientationMixed",
      "value": -2,
      "description": "Not supported"
    },
    {
      "name": "msoTextOrientationHorizontal",
      "value": 1,
      "description": "Horizontal"
    },
    {
      "name": "msoTextOrientationUpward",
      "value": 2,
      "description": "Upward"
    },
    {
      "name": "msoTextOrientationDownward",
      "value": 3,
      "description": "Downward"
    },
    {
      "name": "msoTextOrientationVerticalFarEast",
      "value": 4,
      "description": "Vertical as required for Asian language support"
    },
    {
      "name": "msoTextOrientationVertical",
      "value": 5,
      "description": "Vertical"
    },
    {
      "name": "msoTextOrientationHorizontalRotatedFarEast",
      "value": 6,
      "description": "Horizontal and rotated as required for Asian language support"
    }
  ]
}
