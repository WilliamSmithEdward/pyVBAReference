{
  "name": "MsoAnimEffectRestart",
  "kind": "Enumeration",
  "library": "Microsoft PowerPoint 16.0 Object Library",
  "description": "Specifies whether the animation effect restarts after the effect has started once.",
  "constants": [
    {
      "name": "msoAnimEffectRestartAlways",
      "value": 1,
      "description": "Always restarts."
    },
    {
      "name": "msoAnimEffectRestartWhenOff",
      "value": 2,
      "description": "Restarts when animation is off."
    },
    {
      "name": "msoAnimEffectRestartNever",
      "value": 3,
      "description": "Never restarts."
    }
  ]
}
